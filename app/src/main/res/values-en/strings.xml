    <string name="accessibility_service_label">Android Screen Timer control</string>
    <string name="accessibility_service_description">Tracks only the active app name, counts allowed viewing time, and displays the timer or blocking screen. Window contents are never read or sent anywhere.</string>
    <string name="device_admin_description">Makes Android Screen Timer harder to remove by requiring the system administration protection to be disabled first.</string>

