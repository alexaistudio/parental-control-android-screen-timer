<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ScreenTimerController" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:buttonStyle">@style/ControllerButton</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/controller_background</item>
        <item name="android:navigationBarColor">@color/controller_background</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/controller_primary</item>
    </style>
    <style name="ControllerButton" parent="android:style/Widget.Material.Light.Button">
        <item name="android:background">@drawable/action_background</item>
        <item name="android:textColor">@color/controller_primary_dark</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
